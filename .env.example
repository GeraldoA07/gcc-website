# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# Do not commit .env.local to version control

# =============================================================================
# Supabase Configuration
# Get these values from your Supabase project settings
# https://app.supabase.com/project/YOUR_PROJECT/settings/api
# =============================================================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (Safe to expose in client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (Keep secret, server-side only)
# Only needed for admin operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# Application Configuration
# =============================================================================

# Site URL (used for metadata and canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Analytics (Optional)
# =============================================================================

# Google Analytics Measurement ID
# Get this from: https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager ID (Optional)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# =============================================================================
# Email Service (Optional)
# For contact forms and notifications
# =============================================================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# SendGrid API Key (Alternative to SMTP)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx

# Contact Form Email Recipients
CONTACT_EMAIL_TO=info@gcc.org
CONTACT_EMAIL_FROM=noreply@gcc.org

# =============================================================================
# Social Media (Optional)
# For social sharing and integrations
# =============================================================================

NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id
NEXT_PUBLIC_TWITTER_HANDLE=@YourChurchHandle

# =============================================================================
# Maps & Location (Optional)
# =============================================================================

# Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# =============================================================================
# Payment Gateway (Optional)
# For online donations
# =============================================================================

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# =============================================================================
# Content Delivery Network (Optional)
# =============================================================================

# Cloudinary Configuration (for image optimization)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =============================================================================
# Feature Flags (Optional)
# Enable/disable features during development
# =============================================================================

NEXT_PUBLIC_ENABLE_REGISTRATION=true
NEXT_PUBLIC_ENABLE_DONATIONS=false
NEXT_PUBLIC_ENABLE_LIVE_STREAM=false

# =============================================================================
# Development & Debugging
# =============================================================================

# Node Environment (development, production, test)
NODE_ENV=development

# Enable debug logging
DEBUG=false

# =============================================================================
# Security
# =============================================================================

# JWT Secret (for custom authentication if needed)
JWT_SECRET=your_very_secure_random_string_here

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# Notes
# =============================================================================
# 
# 1. Never commit .env.local or any file containing real credentials
# 2. Use strong, unique values for all secrets
# 3. Rotate keys regularly in production
# 4. Use different values for development, staging, and production
# 5. Store production secrets in your deployment platform (e.g., Vercel)
#
